{
  "info": {
    "_postman_id": "ticketing-platform-collection",
    "name": "Ticketing Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"newuser\",\n    \"email\": \"newuser@example.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"john@example.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/events",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "events"]
            }
          }
        },
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Winter Jazz Festival\",\n    \"description\": \"Annual winter jazz concert\",\n    \"date\": \"2024-12-15 19:00:00\",\n    \"venue\": \"City Concert Hall\",\n    \"total_tickets\": 800,\n    \"price\": 75.50\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/events",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "events"]
            }
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Purchase Ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"event_id\": 1\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/tickets",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "tickets"]
            }
          }
        },
        {
          "name": "Get User Tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/tickets/user",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "tickets", "user"]
            }
          }
        }
      ]
    },
    {
      "name": "Banners",
      "item": [
        {
          "name": "Get Active Banner",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/banners/active",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "banners", "active"]
            }
          }
        },
        {
          "name": "Get All Banners",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/banners",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "banners"]
            }
          }
        },
        {
          "name": "Create Banner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "title",
                  "value": "Summer Promotion",
                  "type": "text"
                },
                {
                  "key": "start_date",
                  "value": "2024-06-01T00:00:00.000Z",
                  "type": "text"
                },
                {
                  "key": "end_date",
                  "value": "2024-08-31T23:59:59.000Z",
                  "type": "text"
                },
                {
                  "key": "is_active",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "event_id",
                  "value": "1",
                  "type": "text",
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "http://localhost:5000/api/banners",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "banners"]
            }
          }
        }
      ]
    }
  ]
}
