  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (Get Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains token\", function () {",
                  "    pm.expect(response.token).to.exist;",
                  "});",
                  "",
                  "pm.test(\"Response contains user\", function () {",
                  "    pm.expect(response.user).to.exist;",
                  "    pm.expect(response.user.email).to.exist;",
                  "    pm.expect(response.user.role).to.exist;",
                  "});",
                  "",
                  "// Enregistrer le token pour les requêtes suivantes",
                  "if (response.token) {",
                  "    pm.environment.set(\"token\", response.token);",
                  "    pm.environment.set(\"userId\", response.user.id.toString());",
                  "}",
                  ""
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains user data\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.id).to.exist;",
                  "    pm.expect(response.email).to.exist;",
                  "    pm.expect(response.username).to.exist;",
                  "    pm.expect(response.role).to.exist;",
                  "});",
                  ""
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "Get All Users (Admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Vérifier si l'utilisateur est admin ou non",
                  "const isAdmin = pm.environment.name.includes('Admin');",
                  "",
                  "if (isAdmin) {",
                  "    pm.test(\"Admin peut accéder à tous les utilisateurs\", function () {",
                  "        pm.response.to.have.status(200);",
                  "        const response = pm.response.json();",
                  "        pm.expect(Array.isArray(response)).to.be.true;",
                  "    });",
                  "} else {",
                  "    pm.test(\"Utilisateur normal ne peut pas accéder à tous les utilisateurs\", function () {",
                  "        pm.response.to.have.status(403);",
                  "        const response = pm.response.json();",
                  "        pm.expect(response.message).to.include('non autorisé');",
                  "    });",
                  "}",
                  ""
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          }
        },
        {
          "name": "Get User By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"User profile access check\", function () {",
                  "    const isAdmin = pm.environment.name.includes('Admin');",
                  "    const userIdFromEnv = pm.environment.get(\"userId\");",
                  "    const pathParts = pm.request.url.path;",
                  "    const requestedUserId = pathParts[pathParts.length - 1]; // Récupère le dernier élément du chemin, qui devrait être l'ID",
                  "    const isOwnProfile = userIdFromEnv === requestedUserId;",
                  "    ",
                  "    if (isAdmin || isOwnProfile) {",
                  "        pm.response.to.have.status(200);",
                  "        const response = pm.response.json();",
                  "        pm.expect(response.id).to.exist;",
                  "        pm.expect(response.email).to.exist;",
                  "    } else {",
                  "        pm.response.to.have.status(403);",
                  "    }",
                  "});",
                  ""
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1"]
            }
          }
        },
