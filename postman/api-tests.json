    {
      "name": "9. Tickets",
      "item": [
        {
          "name": "Buy Ticket (Auth required)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Vérifier si nous avons un ID d'événement",
                  "if (pm.environment.get(\"eventId\")) {",
                  "    pm.test(\"Utilisateur authentifié peut acheter un billet\", function () {",
                  "        const statusCode = pm.response.code;",
                  "        ",
                  "        // Le statut peut être 201 (succès) ou 400/404 (pas de billets disponibles/événement non trouvé)",
                  "        pm.expect(statusCode).to.be.oneOf([201, 400, 404]);",
                  "        ",
                  "        if (statusCode === 201) {",
                  "            const response = pm.response.json();",
                  "            pm.expect(response.message).to.include('Billet acheté');",
                  "            pm.expect(response.ticket).to.exist;",
                  "            pm.expect(response.ticket.id).to.exist;",
                  "            ",
                  "            // Stocker l'ID du billet pour les tests suivants",
                  "            pm.environment.set(\"ticketId\", response.ticket.id);",
                  "        }",
                  "    });",
                  "} else {",
                  "    pm.test(\"Pas d'ID d'événement disponible pour l'achat\", function () {",
                  "        pm.expect(true).to.be.true; // Test toujours réussi",
                  "    });",
                  "}",
                  ""
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
